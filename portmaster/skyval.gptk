# Skyval R36H / PortMaster first-launch controls.
# gptokeyb (not gptokeyb2) button=keyboard layout.
# Emulate keyboard keys to keep D-pad navigation single-source.
# In character creator: UP/DOWN select field, LEFT/RIGHT change value.
# L1/R1 switch tabs, A changes selected value, B closes.
# Right stick rotates the preview via I/J/K/L; Y and Select unbound.

start = c
a = enter
b = esc
x = c

up = up
down = down
left = left
right = right

left_analog_up = up
left_analog_down = down
left_analog_left = left
left_analog_right = right

right_analog_up = i
right_analog_down = k
right_analog_left = j
right_analog_right = l

l1 = q
r1 = e
l2 = 7
r2 = 9

deadzone_mode = scaled_radial
deadzone = 3500
deadzone_scale = 8
mouse_scale = 8192
